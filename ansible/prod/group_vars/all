server_name: voty.ch
certificates: Host(`voty.ch`) ||  Host(`www.voty.ch`)
env_file: ../.env.production
cache_time: 15m
civictools_dynamic_app_url: true
civictools_allowed_hosts:
  - tools.voty.ch
  - prepodavame.voty.ch
  - grajdansko.voty.ch
  - glas.prepodavame.bg
civictools_host_rule: >-
  Host(`tools.voty.ch`) ||
  Host(`prepodavame.voty.ch`) ||
  Host(`grajdansko.voty.ch`) ||
  Host(`glas.prepodavame.bg`)
